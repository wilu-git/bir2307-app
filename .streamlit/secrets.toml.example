# Template for Streamlit Community Cloud's "Secrets" dashboard (Settings ->
# Secrets), used only for the client-demo deployment. Paste the contents
# below (with real values) into that dashboard — do not commit a real
# secrets.toml. Local development uses .env instead (see .env.example).

# Any password you like — this is what you'll hand out to people you demo
# the app to. Not the same password as the real deployment.
APP_PASSWORD = "change-me"

# Turns on synthetic sample data (fake payor/payees/transactions) instead of
# the real placeholder-payor seed. Never set this for the real deployment.
DEMO_MODE = "true"
