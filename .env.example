# Copy this file to .env and fill in real values. Never commit .env.

# SQLAlchemy connection string. Default: local SQLite file outside any web root.
DATABASE_URL=sqlite:///./data/bir2307.db

# Shared app password for the single-user MVP login gate.
APP_PASSWORD=change-me

# Root folder for uploaded Excel files and generated PDFs.
DATA_DIR=./data

# Folder for rotating structured loguru logs.
LOG_DIR=./logs
